{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Robot Configuration Unified Schema",
  "type": "object",
  "properties": {
    "caching": {
      "type": "object",
      "properties": {
        "intake_tolerance": {
          "description": "Power variance tolerance (0.0 to 1.0) for the front and mid intake rollers. If the new command is within this range of the previous write, it is skipped.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "flywheel_tolerance": {
          "description": "Velocity variance tolerance (in encoder ticks per second) below which new speed adjustment commands are dropped to prevent minor noise from saturating the I2C bus.",
          "type": "number",
          "minimum": 0.0
        },
        "hood_tolerance": {
          "description": "Servo position variance tolerance (0.0 to 1.0) below which new position commands are ignored. Reduces servo jitter.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "drivetrain_tolerance": {
          "description": "Motor power variance tolerance (0.0 to 1.0) for chassis wheels. Crucial for reducing loop times.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "intake_tolerance",
        "flywheel_tolerance",
        "hood_tolerance",
        "drivetrain_tolerance"
      ]
    },
    "turret": {
      "type": "object",
      "properties": {
        "max_turn_power": {
          "description": "Upper speed limit (0.0 to 1.0) allowed for chassis turn adjustments when auto-aligning to the goal.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "min_turn_power": {
          "description": "Minimum power (0.0 to 1.0) sent to the drivetrain during auto-turn corrections. Overcomes static wheel friction (stiction). If the robot stops turning before aligning, increase this.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "max_power_output": {
          "description": "Maximum power limit (0.0 to 1.0) commanded to the turret CRServo. Limits maximum turret rotation speed.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "feed_forward": {
          "description": "Feedforward power component (0.0 to 1.0) added to turret rotation to overcome gear backlash and friction. Applied in the direction of movement.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "orientation": {
          "type": "object",
          "properties": {
            "logo": {
              "description": "Mounting orientation direction of the hub's logo panel (e.g. RIGHT, LEFT, UP, DOWN, FORWARD, BACKWARD).",
              "type": "string"
            },
            "usb": {
              "description": "Mounting direction of the hub's USB ports.",
              "type": "string"
            }
          },
          "required": [
            "logo",
            "usb"
          ]
        },
        "turn": {
          "type": "object",
          "properties": {
            "offset_const": {
              "description": "Encoder-to-angle mapping offset (degrees) to align the physical turret zero orientation with the chassis.",
              "type": "number"
            },
            "limit_const": {
              "description": "Mechanical rotation boundary (degrees) measured from center. Prevents the turret from rotating past this limit and tearing internal wires.",
              "type": "number"
            }
          },
          "required": [
            "offset_const",
            "limit_const"
          ]
        },
        "pidf": {
          "type": "object",
          "properties": {
            "p": {
              "description": "Proportional gain.",
              "type": "number"
            },
            "i": {
              "description": "Integral gain.",
              "type": "number"
            },
            "d": {
              "description": "Derivative gain.",
              "type": "number"
            },
            "f": {
              "description": "Feedforward gain.",
              "type": "number"
            }
          },
          "required": [
            "p",
            "i",
            "d",
            "f"
          ]
        },
        "tolerance": {
          "type": "object",
          "properties": {
            "max_drift": {
              "description": "Maximum allowed chassis drift (inches) from target pose before auto-corrective drive motions engage.",
              "type": "number",
              "minimum": 0.0
            },
            "near_cutoff": {
              "description": "Distance boundary (inches) below which the target is considered close, switching to static tolerance.",
              "type": "number",
              "minimum": 0.0
            },
            "near_val": {
              "description": "Target alignment tolerance (degrees) when within the near cutoff range.",
              "type": "number",
              "minimum": 0.0
            },
            "min_deg": {
              "description": "Minimum dynamic alignment tolerance (degrees) allowed. Prevents the turret from hunting indefinitely when very close.",
              "type": "number",
              "minimum": 0.0
            },
            "max_deg": {
              "description": "Maximum dynamic alignment tolerance (degrees) allowed. Prevents launching if the turret orientation error exceeds this.",
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "max_drift",
            "near_cutoff",
            "near_val",
            "min_deg",
            "max_deg"
          ]
        }
      },
      "required": [
        "max_turn_power",
        "min_turn_power",
        "max_power_output",
        "feed_forward",
        "orientation",
        "turn",
        "pidf",
        "tolerance"
      ]
    },
    "vision": {
      "type": "object",
      "properties": {
        "camera_position": {
          "type": "object",
          "properties": {
            "x": {
              "description": "X value coordinate.",
              "type": "number"
            },
            "y": {
              "description": "Y value coordinate.",
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "camera_orientation": {
          "type": "object",
          "properties": {
            "yaw": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "roll": {
              "type": "number"
            }
          },
          "required": [
            "yaw",
            "pitch",
            "roll"
          ]
        }
      },
      "required": [
        "camera_position",
        "camera_orientation"
      ]
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "robot_width": {
          "description": "Total physical width of the robot (inches) used to build the collision footprint. Determines how close the robot can get to walls or goals.",
          "type": "number",
          "minimum": 0.0
        },
        "rotation_lookahead": {
          "description": "Angle (radians) used to project the robot's future rotation. If the robot would violate a goal zone at this lookahead angle, it prevents the turn.",
          "type": "number",
          "minimum": 0.0
        },
        "goals": {
          "type": "object",
          "properties": {
            "size": {
              "description": "Length (inches) of one side of the square scoring goal zones on the field.",
              "type": "number",
              "minimum": 0.0
            },
            "min_y": {
              "description": "The Y-coordinate boundary (inches) on the field where the scoring zones begin. Used to calculate red/blue alliance goal boxes.",
              "type": "number",
              "minimum": 0.0
            },
            "red_goal_x": {
              "description": "Goal center X coordinate for RED alliance.",
              "type": "number",
              "minimum": 0.0
            },
            "red_goal_y": {
              "description": "Goal center Y coordinate for RED alliance.",
              "type": "number",
              "minimum": 0.0
            },
            "blue_goal_x": {
              "description": "Goal center X coordinate for BLUE alliance.",
              "type": "number",
              "minimum": 0.0
            },
            "blue_goal_y": {
              "description": "Goal center Y coordinate for BLUE alliance.",
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "size",
            "min_y",
            "red_goal_x",
            "red_goal_y",
            "blue_goal_x",
            "blue_goal_y"
          ]
        }
      },
      "required": [
        "robot_width",
        "rotation_lookahead",
        "goals"
      ]
    },
    "casablanca": {
      "type": "object",
      "properties": {
        "repulsion": {
          "type": "object",
          "properties": {
            "power": {
              "description": "Motor power (0.0 to 1.0) commanded to push the robot away when it violates a goal zone boundary.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "decel_safety_factor": {
              "description": "Scale factor (0.0 to 1.0) for predictive braking. Lowering this makes braking engage sooner/more aggressively to guarantee the robot doesn't enter the goal zone.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": [
            "power",
            "decel_safety_factor"
          ]
        },
        "depth": {
          "type": "object",
          "properties": {
            "slow_down": {
              "description": "Distance (inches) from the goal zone at which speed reduction warning starts.",
              "type": "number",
              "minimum": 0.0
            },
            "hard_stop": {
              "description": "Distance (inches) from the goal zone where drive power towards the zone is cut to zero.",
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "slow_down",
            "hard_stop"
          ]
        },
        "side": {
          "type": "object",
          "properties": {
            "slow_down": {
              "description": "Distance (inches) from the goal zone at which speed reduction warning starts.",
              "type": "number",
              "minimum": 0.0
            },
            "hard_stop": {
              "description": "Distance (inches) from the goal zone where drive power towards the zone is cut to zero.",
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "slow_down",
            "hard_stop"
          ]
        },
        "lane_blend_distance": {
          "description": "Distance (inches) over which safety slows downs are interpolated from 0% to 100% strength to prevent jerky speed changes.",
          "type": "number",
          "minimum": 0.0
        },
        "friction": {
          "type": "object",
          "properties": {
            "x": {
              "description": "X value coordinate.",
              "type": "number"
            },
            "y": {
              "description": "Y value coordinate.",
              "type": "number"
            },
            "rot": {
              "description": "Minimum turn/yaw drive power (0.0 to 1.0) needed to overcome static wheel stiction. Calibrated using Friction Calibration OpMode.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": [
            "x",
            "y",
            "rot"
          ]
        },
        "smoothing": {
          "type": "object",
          "properties": {
            "time": {
              "description": "Joystick input filter time constant (seconds). Higher values make acceleration and deceleration smoother but increase input lag.",
              "type": "number",
              "minimum": 0.0
            },
            "back_lift_multiplier": {
              "description": "Divisor scaling factor for deceleration. Divides the deceleration rate when stopping to slow down the deceleration curve, preventing the robot from tipping forward and lifting its back wheels.",
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "time",
            "back_lift_multiplier"
          ]
        },
        "heading_lock": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "Enable/disable automatic heading lock when the driver releases the turn joystick in TeleOp.",
              "type": "boolean"
            },
            "kp": {
              "description": "Proportional gain for the controller loop. Higher values correct errors more aggressively.",
              "type": "number",
              "minimum": 0.0
            },
            "max_power": {
              "description": "Maximum motor power (0.0 to 1.0) the loop is allowed to command. Clamped to be completely imperceptible.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "deadband": {
              "description": "Joystick threshold (0.0 to 1.0) below which the heading lock engages.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": [
            "enabled",
            "kp",
            "max_power",
            "deadband"
          ]
        }
      },
      "required": [
        "repulsion",
        "depth",
        "side",
        "lane_blend_distance",
        "friction",
        "smoothing",
        "heading_lock"
      ]
    },
    "shooter": {
      "type": "object",
      "properties": {
        "max_rpm": {
          "description": "Maximum rotational speed (RPM) of the motor. Used to scale power percentage to velocity.",
          "type": "number",
          "minimum": 0.0
        },
        "auto_shoot_mode": {
          "type": "boolean"
        },
        "min_transfer_threshold": {
          "description": "Flywheel speed threshold (percentage, 0.0 to 1.0) required to trigger the transfer belt. Prevents launching rings before the shooter is up to speed.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "pidf": {
          "type": "object",
          "properties": {
            "p": {
              "description": "Proportional gain.",
              "type": "number"
            },
            "i": {
              "description": "Integral gain.",
              "type": "number"
            },
            "d": {
              "description": "Derivative gain.",
              "type": "number"
            },
            "f": {
              "description": "Feedforward gain.",
              "type": "number"
            }
          },
          "required": [
            "p",
            "i",
            "d",
            "f"
          ]
        },
        "launch_params": {
          "type": "object",
          "properties": {
            "threshold_distance": {
              "description": "Distance boundary (inches) separating close-range shots from long-range shots.",
              "type": "number",
              "minimum": 0.0
            },
            "near": {
              "type": "object",
              "properties": {
                "launch_power": {
                  "description": "Flywheel power ratio (0.0 to 1.0) used for close-range shots.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "wait_time": {
                  "description": "Delay (milliseconds) to keep the flywheel running after firing a near shot.",
                  "type": "number",
                  "minimum": 0.0
                }
              },
              "required": [
                "launch_power",
                "wait_time"
              ]
            },
            "far": {
              "type": "object",
              "properties": {
                "blue_base_power": {
                  "description": "Base flywheel power ratio (0.0 to 1.0) for Blue alliance shots beyond the threshold distance.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "red_base_power": {
                  "description": "Base flywheel power ratio (0.0 to 1.0) for Red alliance shots beyond the threshold distance. Red shoots from farther away so this value is intentionally higher.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "power_scale": {
                  "description": "Distance divisor (inches) to scale up flywheel power as distance increases (power = base_power + extra_distance / power_scale).",
                  "type": "number",
                  "minimum": 0.0
                },
                "wait_time_scale": {
                  "description": "Multiplier converting distance to run-time (wait_time = distance * wait_time_scale) in milliseconds.",
                  "type": "number",
                  "minimum": 0.0
                }
              },
              "required": [
                "blue_base_power",
                "red_base_power",
                "power_scale",
                "wait_time_scale"
              ]
            }
          },
          "required": [
            "threshold_distance",
            "near",
            "far"
          ]
        }
      },
      "required": [
        "max_rpm",
        "auto_shoot_mode",
        "min_transfer_threshold",
        "pidf",
        "launch_params"
      ]
    },
    "auto": {
      "type": "object",
      "properties": {
        "drink_wait_ms": {
          "description": "Wait delay (milliseconds) at the drink gate when intake gathers rings.",
          "type": "number",
          "minimum": 0.0
        },
        "shoot_wait_ms": {
          "description": "Wait time (milliseconds) allowed to fire a shot before ending the shoot command.",
          "type": "number",
          "minimum": 0.0
        },
        "launch_power": {
          "description": "Flywheel power ratio (0.0 to 1.0) used for close-range shots.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "transfer_power": {
          "description": "Target power coefficient (0.0 to 1.0) for autonomous transfer motor.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "min_transfer_threshold": {
          "description": "Flywheel speed threshold (percentage, 0.0 to 1.0) required to trigger the transfer belt. Prevents launching rings before the shooter is up to speed.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "opposite_drink_wait_ms": {
          "description": "Wait delay (milliseconds) at the drink gate for opposite alliance autonomous.",
          "type": "number",
          "minimum": 0.0
        },
        "opposite_shoot_wait_ms": {
          "description": "Wait time (milliseconds) allowed to fire a shot for opposite alliance autonomous.",
          "type": "number",
          "minimum": 0.0
        },
        "opposite_launch_power": {
          "description": "Target power coefficient (0.0 to 1.0) for opposite alliance autonomous launcher.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "opposite_transfer_power": {
          "description": "Target power coefficient (0.0 to 1.0) for opposite alliance autonomous transfer.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "opposite_min_transfer_threshold": {
          "description": "Shooter minimum transfer threshold velocity ratio for opposite auto.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "required": [
        "drink_wait_ms",
        "shoot_wait_ms",
        "launch_power",
        "transfer_power",
        "min_transfer_threshold",
        "opposite_drink_wait_ms",
        "opposite_shoot_wait_ms",
        "opposite_launch_power",
        "opposite_transfer_power",
        "opposite_min_transfer_threshold"
      ]
    },
    "teleop": {
      "type": "object",
      "properties": {
        "max_speed": {
          "description": "Maximum speed scaler (0.0 to 1.0) applied to chassis manual TeleOp drive inputs.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "poses": {
          "type": "object",
          "properties": {
            "red": {
              "type": "object",
              "properties": {
                "start": {
                  "description": "Starting position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "score": {
                  "description": "High goal target scoring position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "drink": {
                  "description": "Drink gate alignment coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "park": {
                  "description": "Parking destination coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                }
              },
              "required": [
                "start",
                "score",
                "drink",
                "park"
              ]
            },
            "blue": {
              "type": "object",
              "properties": {
                "start": {
                  "description": "Starting position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "score": {
                  "description": "High goal target scoring position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "drink": {
                  "description": "Drink gate alignment coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "park": {
                  "description": "Parking destination coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                }
              },
              "required": [
                "start",
                "score",
                "drink",
                "park"
              ]
            }
          },
          "required": [
            "red",
            "blue"
          ]
        }
      },
      "required": [
        "max_speed",
        "poses"
      ]
    },
    "auto_poses": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "object",
          "properties": {
            "blue": {
              "type": "object",
              "properties": {
                "start": {
                  "description": "Starting position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "score": {
                  "description": "High goal target scoring position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "final_score": {
                  "description": "Final scoring target position coordinate pose.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "drink_cp": {
                  "description": "Control point pose on path to drink gate.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "drink_end": {
                  "description": "Ending position coordinate pose at the drink gate.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "pickup1_cp": {
                  "description": "Control point pose on path to first sample pickup.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "pickup1_end": {
                  "description": "Ending position coordinate pose for first sample pickup.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "pickup2_cp": {
                  "description": "Control point pose on path to second sample pickup.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "pickup2_end": {
                  "description": "Ending position coordinate pose for second sample pickup.",
                  "oneOf": [
                    {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                    {"type": "string", "enum": ["m", "M", "mirror", "MIRROR"]}
                  ]
                },
                "pickup3_cp": {
